generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 1. السيرفرات العامة لكل الموقع
model StreamGateway {
  id           String   @id @default(cuid())
  name         String
  moviePattern String
  tvPattern    String
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

// 2. السيرفرات المخصصة والاستثناءات الفردية
model CustomStreamOverride {
  id         String   @id @default(cuid())
  tmdbId     Int
  mediaType  String
  title      String
  serverName String
  customUrl  String
  season     Int?
  episode    Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tmdbId, mediaType])
}

model User {
  id           String         @id @default(cuid())
  name         String?
  email        String         @unique
  password     String?
  role         String         @default("USER")
  isBanned     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  watchHistory WatchHistory[]
  favorites    Favorite[]
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    String
  mediaType String
  title     String
  poster    String?
  season    Int?
  episode   Int?
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    String
  mediaType String
  title     String
  poster    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}